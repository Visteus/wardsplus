{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (Debug, deploy to Gale profile)",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "-c", "Debug"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Package (Release, Thunderstore zip)",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "-c", "Release"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Clean",
      "type": "process",
      "command": "dotnet",
      "args": ["clean"],
      "problemMatcher": []
    }
  ]
}
