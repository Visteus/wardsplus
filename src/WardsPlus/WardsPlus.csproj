<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Most build settings live in ../../Directory.Build.props and ../../Directory.Build.targets.
    This file only holds what is specific to THIS mod.
  -->
  <PropertyGroup>
    <!-- Thunderstore package name. Letters, digits and underscores only. -->
    <ModName>WardsPlus</ModName>
    <!-- Your Thunderstore team name. -->
    <ModAuthor>Visteus</ModAuthor>
    <!--
      BepInEx plugin GUID: globally unique, reverse-domain style.
      Do NOT change it after release: it names the config file and other mods depend on it.
    -->
    <ModGuid>visteus.wardsplus</ModGuid>
    <!-- The ONLY place to bump the version. Plain Major.Minor.Patch. -->
    <Version>1.0.0</Version>

    <AssemblyName>$(ModName)</AssemblyName>
    <RootNamespace>WardsPlus</RootNamespace>
  </PropertyGroup>

  <!-- Extra game DLLs beyond the defaults in Directory.Build.props (Jotunn's CustomPiece API exposes AssetBundle). -->
  <ItemGroup>
    <ValheimReference Include="UnityEngine.AssetBundleModule" />
  </ItemGroup>

  <!-- Library mods installed in the Gale profile. -->
  <ItemGroup>
    <Reference Include="Jotunn" HintPath="$(BepInExPlugins)\ValheimModding-Jotunn\Jotunn.dll" Private="false" />
  </ItemGroup>

  <!-- Translation files are embedded so the mod ships as a single DLL. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Translations\*.json" LogicalName="WardsPlus.Translations.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
